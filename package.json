{
  "name": "foodiebite-app",
  "version": "1.0.0",
  "private": true,
  "description": "FoodieBite Monorepo",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "start": "node scripts/startApp.js",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd frontend && npm start",
    "test": "cd backend && npm test",
    "test:1:safety": "node scripts/runTestsAndExportExcel.js --suite=1",
    "test:2:ai": "node scripts/runTestsAndExportExcel.js --suite=2",
    "test:3:email": "node scripts/runTestsAndExportExcel.js --suite=3",
    "test:4:frontend": "node scripts/runTestsAndExportExcel.js --suite=4",
    "test:all-4": "node scripts/runTestsAndExportExcel.js --all",
    "test:report:excel": "node scripts/runTestsAndExportExcel.js --all",
    "test:frontend": "node frontend/src/services/__tests__/nutritionScanner.test.mjs",
    "security:scan": "node scripts/generateSecurityReports.js",
    "test:selenium": "node tests/selenium/runner.js",
    "test:selenium:smoke": "cd selenium-tests && node runner.js --headless",
    "test:selenium:all": "node tests/selenium/runner.js",
    "test:selenium:report": "node selenium-tests/scripts/generateSeleniumExcelReport.js",
    "test:appium": "node tests/appium/runner.js",
    "test:appium:smoke": "cd appium-tests && node scripts/runMockAppiumRunner.js",
    "test:appium:all": "node tests/appium/runner.js",
    "test:appium:report": "node appium-tests/scripts/generateAppiumExcelReport.js",
    "test:api": "node tests/api/runner.js",
    "test:integration": "node tests/integration/runner.js",
    "test:performance": "node tests/performance/runner.js",
    "test:security": "node tests/security/runner.js",
    "test:all": "node scripts/testing/runAllTests.js",
    "test:reports": "node scripts/testing/generateMasterReport.js",
    "test:validate-workflows": "node scripts/testing/validateWorkflows.js",
    "test:load": "node scripts/runBaselineLoadTest.js --concurrency=100 --duration=60 --multi",
    "test:load:quick": "node scripts/runBaselineLoadTest.js --concurrency=100 --duration=10",
    "test:qa": "node scripts/testing/runAllTests.js",
    "report:qa": "node scripts/testing/generateMasterReport.js",
    "build": "cd frontend && npm install --include=dev && npm run build"
  },
  "devDependencies": {
    "exceljs": "^4.4.0"
  }
}
