# ─── Server Configuration ──────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Database Configuration ───────────────────────────
MONGO_URI=mongodb://localhost:27017/foodiebite

# ─── Security & JWT ───────────────────────────────────
JWT_SECRET=your_production_jwt_secret_key_here
JWT_EXPIRE=7d

# ─── File Uploads ─────────────────────────────────────
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# ─── CORS Frontend URL ────────────────────────────────
CLIENT_URL=http://localhost:3000

# ─── Food Delivery Provider ───────────────────────────
FOOD_DELIVERY_PROVIDER=mealme
MEALME_COMPANY_NAME=

# ─── Firebase Admin SDK ───────────────────────────────
FIREBASE_PROJECT_ID=mock-foodiebite

# ─── Cloudinary Configuration ─────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── FoodieBite AI Engine Configuration ────────────────
# Core AI engine runs 100% locally with 0 external AI dependencies
AI_PROVIDER=custom_rest
AI_API_KEY=foodiebite_ai_live_key_2026
AI_MODEL=foodiebite-ai-v1
AI_API_URL=
FORCE_FALLBACK=false

# ─── Gmail SMTP Configuration ─────────────────────────
# Sender email: foodiebite881@gmail.com
# Port 587 uses STARTTLS encryption
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=foodiebite881@gmail.com
# IMPORTANT: Generate a 16-character App Password at https://myaccount.google.com/apppasswords
# Never use the primary Gmail account password.
SMTP_PASS=your_16_character_google_app_password_here
SMTP_FROM="FoodieBite" <foodiebite881@gmail.com>

# ─── Resend Email Service Configuration ───────────────
# HTTPS-based email delivery via official Resend SDK (replaces SMTP)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=FoodieBite <onboarding@resend.dev>

