# ─── Server Configuration ──────────────────────────────
PORT=5000
NODE_ENV=production

# ─── Database Configuration ───────────────────────────
MONGO_URI=mongodb://localhost:27017/foodiebite

# ─── Security & JWT ───────────────────────────────────
JWT_SECRET=your_production_jwt_secret_key_here
JWT_EXPIRE=7d

# ─── File Uploads ─────────────────────────────────────
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# ─── CORS Frontend URL ────────────────────────────────
CLIENT_URL=http://localhost:3000

# ─── Food Delivery Provider ───────────────────────────
FOOD_DELIVERY_PROVIDER=mealme
MEALME_COMPANY_NAME=

# ─── Firebase Admin SDK ───────────────────────────────
FIREBASE_PROJECT_ID=mock-foodiebite

# ─── Cloudinary Configuration ─────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Local Ollama AI Engine Configuration ────────────────
# Connects to locally running Ollama (default: http://localhost:11434)
# Models supported: qwen2.5:0.5b, qwen2.5:3b, llama3.2:1b, mistral, etc.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT_MS=30000
AI_API_KEY=foodiebite_ai_live_key_2026
FORCE_FALLBACK=false

# ─── Gmail SMTP Configuration ─────────────────────────
# Sender email: foodiebite881@gmail.com
# Port 587 uses STARTTLS encryption
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=foodiebite881@gmail.com
# IMPORTANT: Generate a 16-character App Password at https://myaccount.google.com/apppasswords
# Never use the primary Gmail account password.
SMTP_PASS=your_16_character_google_app_password_here
SMTP_FROM="FoodieBite" <foodiebite881@gmail.com>

# ─── Brevo Email Service Configuration (Primary Engine) ───────────
# Official Brevo REST API v3 - Verified sender: foodiebite881@gmail.com
# Get your API key from https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib_your_brevo_api_key_here
BREVO_SENDER_EMAIL=foodiebite881@gmail.com
BREVO_SENDER_NAME=FoodieBite
BREVO_DAILY_QUOTA_LIMIT=300
DAILY_RECOMMENDATION_ENABLED=true
DAILY_RECOMMENDATION_CRON=0 * * * *
DAILY_RECOMMENDATION_TIMEZONE=Asia/Kolkata

# ─── Resend Email Service Configuration ───────────────
# HTTPS-based email delivery via official Resend SDK (replaces SMTP)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=FoodieBite <onboarding@resend.dev>

# ─── Supabase PostgreSQL Configuration ─────────────────
# Supabase project URL and API keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Optional: Service Role Key for backend administration (NEVER expose to frontend)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Optional: Supabase JWT Secret for offline HMAC verification
# SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

