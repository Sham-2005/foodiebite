        { "max": 69, "status": "Low", "concern": "Low Blood Sugar", "tag": "hypoglycemia", "severity": "moderate" },
        { "max": 99, "status": "Normal", "concern": null, "tag": null, "severity": "normal" },
        { "max": 125, "status": "High", "concern": "Elevated Blood Sugar", "tag": "prediabetic", "severity": "moderate" },
        { "max": null, "status": "Critical", "concern": "High Blood Sugar", "tag": "diabetic", "severity": "high" }
      ],
      "foodRules": {
        "prediabetic": { "limit": ["refined-sugar", "high-glycemic"], "prefer": ["high-fiber", "low-gi"] },
        "diabetic": { "limit": ["refined-sugar", "high-glycemic"], "prefer": ["high-fiber", "low-gi"] }
      }
    },
