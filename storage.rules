rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Medical Reports: strictly private to the owner
    match /medical-reports/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /medical_reports/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Profile Pictures: strictly private to the owner
    match /profile_pictures/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Food Images: publicly readable, but writeable only by authenticated users
    match /food_images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
