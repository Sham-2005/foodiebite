# ─── FoodieBite Web Frontend Environment Configuration ───
REACT_APP_API_URL=https://foodiebite-backend.onrender.com/api
NEXT_PUBLIC_API_URL=https://foodiebite-backend.onrender.com/api

# For local development against a local backend, uncomment:
# REACT_APP_API_URL=http://localhost:5000/api

# ─── Supabase Configuration ──────────────────────────────
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── Google OAuth Configuration ───────────────────────────
REACT_APP_GOOGLE_WEB_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── Testing & Automation Configuration ───────────────────
BASE_URL=http://localhost:3000
API_BASE_URL=http://127.0.0.1:5000
HEADLESS=true
WEB_TIMEOUT_MS=15000
API_TIMEOUT_MS=10000

# Synthetic Test Users
TEST_USERNAME=testuser@foodiebite.dev
TEST_PASSWORD=FoodieBite#2026Test
ADMIN_TEST_USERNAME=admin@foodiebite.dev
ADMIN_TEST_PASSWORD=Admin#2026Secure!
ADMIN_KEY=foodiebite_admin_secret_key_2026

# Android Appium Mobile Testing Configuration
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723
ANDROID_APP_PACKAGE=com.foodiebite.app
ANDROID_APP_ACTIVITY=.MainActivity
ANDROID_APK_PATH=./frontend/android/app/build/outputs/apk/release/app-release-unsigned.apk
ANDROID_DEVICE_NAME=Android Emulator
ANDROID_PLATFORM_VERSION=13.0

# Performance / Load Testing Parameters
LOAD_CONCURRENCY=100
LOAD_DURATION_SEC=60

# ─── External Service Keys (CI GitHub Secrets) ───────────
BREVO_API_KEY=xkeysib_your_brevo_api_key_here
RESEND_API_KEY=re_your_resend_api_key_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=foodiebite881@gmail.com
SMTP_PASS=your_google_app_password
